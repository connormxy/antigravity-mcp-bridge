# Antigravity MCP Bridge Configuration

# Host paths to mount into container
HOST_WORKSPACE_PATH=./workspaces
HOST_GEMINI_CONFIG_PATH=~/.gemini

# Path to the mounted workspace root inside the container
WORKSPACE_DIR=/workspace

# Server Port and Host binding
PORT_BINDING=8085
PORT=8080
HOST=0.0.0.0

# Sub-Agent Model & Effort Defaults
DEFAULT_MODEL=gemini-3.7-flash
DEFAULT_EFFORT=low
DEFAULT_TIMEOUT_SECONDS=300
AUTO_APPROVE_PERMISSIONS=true

# Optional extra flags to append to agy CLI (e.g. "--sandbox")
EXTRA_AGY_FLAGS=

# API Keys & Auth for Antigravity / Gemini models (if not using mounted ~/.gemini)
GEMINI_API_KEY=
ANTIGRAVITY_API_KEY=
